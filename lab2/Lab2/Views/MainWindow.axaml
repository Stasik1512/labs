<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lab2.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Lab2.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Lab2">

<!--/////////////////////////////////////////////////////////// -->
    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <Menu Grid.Row="0" DockPanel.Dock="Top">
                <MenuItem Header="Файл">
                    <MenuItem Header="Открыть" />
                    <MenuItem Header="Создать новый файл"/>
                    <MenuItem Header="Сохранить"/>
                    <MenuItem Header="Сохранить как"/>
                    <MenuItem Header="Выход"/>
                </MenuItem>
                <MenuItem Header="Правка">
                    <MenuItem Header="Отменить"/>
                    <MenuItem Header="Повторить"/>
                    <MenuItem Header="Вырезать"/>
                    <MenuItem Header="Копировать"/>
                    <MenuItem Header="Вставить"/>
                </MenuItem>
                <MenuItem Header="Вид">
                    <MenuItem Header="О программе"/>
                    <MenuItem Header="Расширения"/>
                    <MenuItem Header="Выполнить"/>
                </MenuItem>
                <MenuItem Header="Справка">
                    <MenuItem Header="Справка"/>
                    <MenuItem Header="Обновления"/>
                    <MenuItem Header="Проверить обновления"/>
                </MenuItem>
            </Menu>
            
            <Border Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Новый"></Button>
                    <Button Content="Сохранить"></Button>
                    <Button Content="Поиск"></Button>
                    <Button Content="Настройки"></Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" DockPanel.Dock="Left" Background="LightGray">
                    <TextBlock FontSize="18" >Проводник</TextBlock>
                    <Button Content="Проекты"></Button>
                    <Button Content="Документы"></Button>
                    <Button Content="Изображения"></Button>
                </StackPanel>
                    <GridSplitter Grid.Column="1" Width="5" Background="Gray" HorizontalAlignment="Stretch"/>
                    <StackPanel Grid.Column="2" Background="White">
                    <TextBlock FontSize="18">Файлы</TextBlock>
                    <Button Content="file1.txt"></Button>
                    <Button Content="image.png"></Button>
                    <Button Content="document.pdf"></Button>
                </StackPanel>
                <GridSplitter Grid.Column="3" Width="5" Background="Gray" HorizontalAlignment="Stretch"/>

                <StackPanel Grid.Column="4" Background="White">
                    <TextBlock FontSize="18">Область просмотра / Редактор</TextBlock>
                    <TextBlock FontSize="15" Foreground="Gray">Здесь будет содержимое выбранного файла</TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Height="30" Background="#F0F0F0" ColumnDefinitions="*, Auto, Auto">
                <!-- Левая часть: основной статус -->
                <TextBlock Grid.Column="0" Text="Готово" VerticalAlignment="Center" Margin="10,0"/>
                
                <!-- Средняя часть: дополнительная информация (например, позиция курсора) -->
                <TextBlock Grid.Column="1" Text="Стр 1, Кол 1" VerticalAlignment="Center" Margin="10,0"/>
                
                <!-- Правая часть: индикатор или прогресс -->
                <ProgressBar Grid.Column="2" Value="50" Width="100" Height="14" Margin="10,0" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
